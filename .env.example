# Database
DATABASE_URL="mysql://root:@127.0.0.1:3306/dataportal"

# JWT Secret (set a long random secret in production)
JWT_SECRET="replace-with-a-strong-random-secret"

# Emails com acesso admin (separados por vírgula). Também pode usar npm run create-admin.
ADMIN_EMAILS="admin@data4moz.com"

# Application URL
NEXTAUTH_URL="http://localhost:3000"

# Contact form recipient email
CONTACT_RECIPIENT_EMAIL="portaldedados@data4moz.com"

# SMTP settings for contact form delivery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user@gmail.com"
SMTP_PASS="your-app-password"
SMTP_SECURE="false"

# Allowed CORS origins (comma separated)
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://your-domain.com"

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LinkedIn OAuth (LinkedIn Developer Portal > "Sign In with LinkedIn using OpenID Connect")
# Authorized redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Anthropic (Claude) API — AI Insights (console.anthropic.com > Settings > API Keys)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# Redis (opcional) — partilha o rate limiting entre múltiplas instâncias/serverless.
# Se não definido, usa um contador em memória por processo (suficiente para uma única instância).
REDIS_URL=""

# Mapillary (visor de ruas 360°, /ruas-360) — criar em mapillary.com/dashboard/developers.
# NEXT_PUBLIC_ de propósito: o visor corre no browser, e o Client Token do Mapillary é feito
# para uso do lado do cliente (não é um segredo de servidor como as outras chaves acima).
NEXT_PUBLIC_MAPILLARY_TOKEN=""
